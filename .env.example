# =============================================================================
# LLM PROVIDERS — set at least one
# Each agent YAML selects its provider via the "provider:" field.
# =============================================================================

# Anthropic — Claude models (claude-opus-4-6, claude-sonnet-4-6, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — GPT-4o, GPT-4o-mini, o1, etc.
# OPENAI_API_KEY=sk-...

# OpenRouter — access 100+ models via one API key
# Models: "openai/gpt-4o", "anthropic/claude-opus-4-6", "google/gemini-pro", etc.
# OPENROUTER_API_KEY=sk-or-...

# DeepSeek — deepseek-chat, deepseek-reasoner
# DEEPSEEK_API_KEY=sk-...

# Ollama — local models (no API key needed, set base URL only)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# TELEGRAM
# =============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Comma-separated list of allowed chat IDs (leave empty to allow all)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_ID=

# =============================================================================
# DIRECTORIES (defaults shown — override if needed)
# =============================================================================
DATA_DIR=./memory
AGENTS_DIR=./agents
SKILLS_DIR=./skills
TOOLS_DIR=./tools

# =============================================================================
# MISC
# =============================================================================
LOG_LEVEL=INFO
VECTOR_STORE_PATH=./memory/vector

# Optional: Telegram webhook mode (leave unset to use polling)
# WEBHOOK_URL=https://your-app.onrender.com/telegram/webhook
# WEBHOOK_PORT=8443
