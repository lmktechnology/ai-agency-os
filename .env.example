# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Comma-separated list of allowed chat IDs (leave empty to allow all)
TELEGRAM_ALLOWED_CHAT_IDS=

# === Directories (defaults shown) ===
DATA_DIR=./memory
AGENTS_DIR=./agents
SKILLS_DIR=./skills
TOOLS_DIR=./tools

# === Logging ===
LOG_LEVEL=INFO

# === Optional: Telegram admin chat for cron job replies ===
TELEGRAM_ADMIN_CHAT_ID=

# === Optional: Webhook mode (leave unset to use polling) ===
# WEBHOOK_URL=https://your-app.onrender.com/telegram/webhook
# WEBHOOK_PORT=8443

# === Optional: Vector store (ChromaDB) ===
VECTOR_STORE_PATH=./memory/vector
